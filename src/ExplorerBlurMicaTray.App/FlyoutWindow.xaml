<Window x:Class="ExplorerBlurMicaTray.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Variant A of the design: 320 px, header, materials, tint, footer with preset and Apply. -->
    <Grid x:Name="Root" Width="320" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The preset list opens beside the whole flyout, on its left, outside its small window. -->
        <FlyoutBase.AttachedFlyout>
            <MenuFlyout x:Name="PresetMenu" ShouldConstrainToRootBounds="False" />
        </FlyoutBase.AttachedFlyout>

        <!-- The blend color ExplorerBlurMica draws over Explorer, previewed over this window's backdrop. -->
        <Border x:Name="BlendLayer" Grid.RowSpan="2" />

        <StackPanel Padding="12" Spacing="10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/app.png" Width="20" Height="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <InfoBar x:Name="TransparencyBar" Severity="Warning" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button x:Name="ColorSettingsButton" Click="OnOpenColorSettings" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />

            <StackPanel x:Name="EffectPanel" Spacing="10">
                <Grid x:Name="MaterialGrid" ColumnSpacing="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE706;" FontSize="16" VerticalAlignment="Center" />
                    <Slider x:Name="TintSlider" Grid.Column="1" Minimum="0" Maximum="100" StepFrequency="1"
                            VerticalAlignment="Center" ValueChanged="OnTintChanged" />
                    <TextBlock x:Name="TintText" Grid.Column="2" Width="34" TextAlignment="Right"
                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
            </StackPanel>

            <StackPanel x:Name="InstallPanel" Spacing="8">
                <TextBlock x:Name="InstallTitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="InstallBodyText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="InstallProgress" Visibility="Collapsed" />
                <TextBlock x:Name="InstallStatusText" Style="{StaticResource CaptionTextBlockStyle}" Visibility="Collapsed" />
                <Button x:Name="InstallButton" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Click="OnInstall" />
                <TextBlock x:Name="InstallNoteText" Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="Footer" Grid.Row="1" Padding="12,8" ColumnSpacing="8" Background="#1A000000"
              BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PresetButton" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Click="OnPresetButton">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PresetText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <FontIcon Grid.Column="1" Glyph="&#xE76B;" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Button>
            <Button x:Name="ApplyButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnApply" />
        </Grid>
    </Grid>
</Window>
