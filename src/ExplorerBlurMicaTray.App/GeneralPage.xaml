<UserControl x:Class="ExplorerBlurMicaTray.App.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,16,40,32">
            <TextBlock x:Name="HeaderText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

            <StackPanel Spacing="8">
                <InfoBar x:Name="RestartBar" Severity="Informational" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="RestartButton" Click="OnRestart" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />
            </StackPanel>

            <!-- App -->
            <TextBlock x:Name="AppHeader" Style="{StaticResource SettingsSectionHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7E8;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AutostartTitle" />
                            <TextBlock x:Name="AutostartDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutostartSwitch" Grid.Column="2" OnContent="" OffContent="" MinWidth="0" Toggled="OnAutostartToggled" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE75B;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TrayIconTitle" />
                            <TextBlock x:Name="TrayIconDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="TaskbarSettingsButton" Grid.Column="2" VerticalAlignment="Center" Click="OnTaskbarSettings" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xF2B7;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LanguageTitle" />
                            <TextBlock x:Name="LanguageDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="LanguageBox" Grid.Column="2" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnLanguageChanged" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE962;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LeftClickTitle" />
                            <TextBlock x:Name="LeftClickDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ComboBox x:Name="LeftClickBox" Grid.Column="2" MinWidth="220" VerticalAlignment="Center" SelectionChanged="OnLeftClickChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ExplorerBlurMica -->
            <TextBlock Text="ExplorerBlurMica" Style="{StaticResource SettingsSectionHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="EbmStatusText" />
                            <TextBlock x:Name="EbmSourceText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="UpdateText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="UpdateButton" Style="{StaticResource AccentButtonStyle}" Click="OnInstallLatest" />
                            <Button x:Name="CheckButton" Click="OnCheckUpdates" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="ReinstallLine" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid x:Name="ReinstallRow" Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ReinstallTitle" />
                            <TextBlock x:Name="ReinstallDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="ReinstallButton" Grid.Column="1" VerticalAlignment="Center" Click="OnInstallLatest" />
                    </Grid>
                    <Border x:Name="UninstallLine" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid x:Name="UninstallRow" Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UninstallTitle" />
                            <TextBlock x:Name="UninstallDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="UninstallButton" Grid.Column="1" VerticalAlignment="Center" Click="OnUninstall" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock x:Name="AboutHeader" Style="{StaticResource SettingsSectionHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="Assets/app.png" Width="20" Height="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ExplorerBlurMica Tray" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton x:Name="SourceLink" Grid.Column="2" VerticalAlignment="Center"
                                         NavigateUri="https://github.com/Duduka-INC/ExplorerBlurMica-Tray" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE734;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="CreditTitle" TextWrapping="Wrap" />
                            <TextBlock x:Name="CreditDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <HyperlinkButton x:Name="ProjectLink" Grid.Column="2" VerticalAlignment="Center"
                                         NavigateUri="https://github.com/Maplespe/ExplorerBlurMica" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
