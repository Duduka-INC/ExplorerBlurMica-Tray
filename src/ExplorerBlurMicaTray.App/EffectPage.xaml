<UserControl x:Class="ExplorerBlurMicaTray.App.EffectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ExplorerBlurMicaTray.App">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,16,40,32">
            <TextBlock x:Name="HeaderText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <StackPanel Spacing="8">
                <InfoBar x:Name="NotInstalledBar" Severity="Warning" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="InstallButton" Click="OnInstall" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="TransparencyBar" Severity="Warning" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="ColorSettingsButton" Click="OnOpenColorSettings" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="PendingBar" Severity="Informational" IsClosable="False">
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                            <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Click="OnApply" />
                            <Button x:Name="DiscardButton" Click="OnDiscard" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />
            </StackPanel>

            <!-- Preview: a File Explorer window over the user's wallpaper, partly over another window. -->
            <Grid x:Name="Preview" Height="336" Margin="0,12,0,0" CornerRadius="8" Background="#FF1E2A44">
                <Image x:Name="WallpaperImage" Stretch="UniformToFill" />
                <Border Width="220" Height="170" Margin="470,44,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                        CornerRadius="10" Background="#FFFFD43B" />
                <local:ExplorerSketch x:Name="MiniWindow" Width="580" Height="294" Margin="28,22,0,0"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="8,2" CornerRadius="4" Background="#80000000">
                    <TextBlock x:Name="PreviewLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="White" />
                </Border>
            </Grid>
            <TextBlock x:Name="MaterialDescription" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,8,0,0" />

            <Border Style="{StaticResource SettingsCard}" Margin="0,20,0,0">
                <Grid Style="{StaticResource SettingsCardRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="MaterialTitle" />
                        <TextBlock x:Name="MaterialSubtitle" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <local:MaterialSelector x:Name="MaterialPicker" Grid.Column="2" Width="400" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Only Acrylic draws the blend color, and only the one of the current Windows theme. -->
            <StackPanel x:Name="ColorsSection">
                <TextBlock x:Name="ColorsHeader" Style="{StaticResource SettingsSectionHeader}" />
                <Border Style="{StaticResource SettingsCard}">
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="BlendIcon" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="BlendTitle" />
                            <TextBlock x:Name="BlendSubtitle" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="BlendSwatch" Grid.Column="2" Width="44" Height="32" Padding="4" VerticalAlignment="Center">
                            <Border x:Name="BlendSwatchFill" Width="34" Height="22" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="BlendPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                 IsColorChannelTextInputVisible="False" ColorChanged="OnBlendColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Slider x:Name="BlendSlider" Grid.Column="3" Width="180" Minimum="0" Maximum="100" StepFrequency="1"
                                VerticalAlignment="Center" ValueChanged="OnBlendAlphaChanged" />
                        <TextBlock x:Name="BlendValue" Grid.Column="4" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                        <Button x:Name="SystemBlendButton" Grid.Column="5" VerticalAlignment="Center" Click="OnSystemBlend" />
                    </Grid>
                </Border>
            </StackPanel>

            <Expander x:Name="AdvancedExpander" Margin="0,24,0,0" Padding="0" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9E9;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AdvancedTitle" />
                            <TextBlock x:Name="AdvancedSubtitle" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <!-- Rows for parts this Windows version doesn't have are collapsed with the line under them. -->
                    <Grid x:Name="ClearAddressRow" Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClearAddressTitle" />
                            <TextBlock x:Name="ClearAddressDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ClearAddressSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAdvancedToggled" />
                    </Grid>
                    <Border x:Name="ClearAddressLine" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClearBarBgTitle" />
                            <TextBlock x:Name="ClearBarBgDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ClearBarBgSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAdvancedToggled" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid x:Name="ClearWinUIBgRow" Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClearWinUIBgTitle" />
                            <TextBlock x:Name="ClearWinUIBgDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ClearWinUIBgSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAdvancedToggled" />
                    </Grid>
                    <Border x:Name="ClearWinUIBgLine" Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ShowLineTitle" />
                            <TextBlock x:Name="ShowLineDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ShowLineSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAdvancedToggled" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
