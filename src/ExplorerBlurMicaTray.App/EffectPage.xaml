<UserControl x:Class="ExplorerBlurMicaTray.App.EffectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ExplorerBlurMicaTray.App">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,16,40,32">
            <TextBlock x:Name="HeaderText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,20" />

            <StackPanel Spacing="8">
                <InfoBar x:Name="NotInstalledBar" Severity="Warning" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="InstallButton" Click="OnInstall" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="TransparencyBar" Severity="Warning" IsClosable="False">
                    <InfoBar.ActionButton>
                        <Button x:Name="ColorSettingsButton" Click="OnOpenColorSettings" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar x:Name="PendingBar" Severity="Informational" IsClosable="False">
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                            <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Click="OnApply" />
                            <Button x:Name="DiscardButton" Click="OnDiscard" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>
                <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />
            </StackPanel>

            <!-- Preview: a sketch of an Explorer window over the user's wallpaper, next to another window. -->
            <Grid x:Name="Preview" Height="190" Margin="0,12,0,0" CornerRadius="8" Background="#FF1E2A44">
                <Image x:Name="WallpaperImage" Stretch="UniformToFill" />
                <Border Width="160" Height="110" Margin="330,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                        CornerRadius="10" Background="#FFFFD43B" />
                <Grid x:Name="MiniWindow" Width="380" Height="142" Margin="40,24,0,0" HorizontalAlignment="Left"
                      VerticalAlignment="Top" CornerRadius="8" BorderThickness="1" BorderBrush="#40FFFFFF">
                    <!-- Mica shows only the wallpaper under the window, never the windows behind it. -->
                    <Image x:Name="MicaWallpaper" Stretch="UniformToFill" HorizontalAlignment="Left"
                           VerticalAlignment="Top" Margin="-41,-25,0,0" />
                    <Border x:Name="MiniTint" />
                    <StackPanel Padding="10,8" Spacing="8">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.4" />
                            <Rectangle Grid.Column="2" Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.25" />
                        </Grid>
                        <Rectangle Height="14" RadiusX="4" RadiusY="4" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.1" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="7">
                                <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.28" />
                                <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.28" />
                                <Rectangle Height="6" Width="60" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.28" />
                                <Rectangle Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.28" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="7">
                                <Rectangle Height="6" Width="190" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="#B3F2C55C" />
                                <Rectangle Height="6" Width="150" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="#B3F2C55C" />
                                <Rectangle Height="6" Width="210" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.28" />
                                <Rectangle Height="6" Width="170" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Fill="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.28" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Padding="8,2" CornerRadius="4" Background="#80000000">
                    <TextBlock x:Name="PreviewLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="White" />
                </Border>
            </Grid>
            <TextBlock x:Name="MaterialDescription" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,8,0,0" />

            <Border Style="{StaticResource SettingsCard}" Margin="0,20,0,0">
                <Grid Style="{StaticResource SettingsCardRow}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE790;" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="MaterialTitle" />
                        <TextBlock x:Name="MaterialSubtitle" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <local:MaterialSelector x:Name="MaterialPicker" Grid.Column="2" Width="400" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock x:Name="ColorsHeader" Style="{StaticResource SettingsSectionHeader}" />
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE708;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="DarkTitle" />
                            <TextBlock x:Name="DarkSubtitle" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="DarkSwatch" Grid.Column="2" Width="44" Height="32" Padding="4" VerticalAlignment="Center">
                            <Border x:Name="DarkSwatchFill" Width="34" Height="22" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="DarkPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                 IsColorChannelTextInputVisible="False" ColorChanged="OnDarkColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Slider x:Name="DarkSlider" Grid.Column="3" Width="200" Minimum="0" Maximum="100" StepFrequency="1"
                                VerticalAlignment="Center" ValueChanged="OnDarkAlphaChanged" />
                        <TextBlock x:Name="DarkValue" Grid.Column="4" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE706;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="LightTitle" />
                            <TextBlock x:Name="LightSubtitle" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="LightSwatch" Grid.Column="2" Width="44" Height="32" Padding="4" VerticalAlignment="Center">
                            <Border x:Name="LightSwatchFill" Width="34" Height="22" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" />
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="LightPicker" IsAlphaEnabled="False" IsMoreButtonVisible="False"
                                                 IsColorChannelTextInputVisible="False" ColorChanged="OnLightColorChanged" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Slider x:Name="LightSlider" Grid.Column="3" Width="200" Minimum="0" Maximum="100" StepFrequency="1"
                                VerticalAlignment="Center" ValueChanged="OnLightAlphaChanged" />
                        <TextBlock x:Name="LightValue" Grid.Column="4" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock x:Name="TintHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,8,0,0" />

            <Expander x:Name="AdvancedExpander" Margin="0,24,0,0" Padding="0" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid ColumnSpacing="16" Padding="0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9E9;" FontSize="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="AdvancedTitle" />
                            <TextBlock x:Name="AdvancedSubtitle" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Expander.Header>
                <StackPanel>
                    <Grid Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClearAddressTitle" />
                            <TextBlock x:Name="ClearAddressDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ClearAddressSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAdvancedToggled" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClearBarBgTitle" />
                            <TextBlock x:Name="ClearBarBgDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ClearBarBgSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAdvancedToggled" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ClearWinUIBgTitle" />
                            <TextBlock x:Name="ClearWinUIBgDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ClearWinUIBgSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAdvancedToggled" />
                    </Grid>
                    <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />
                    <Grid Style="{StaticResource SettingsCardRow}" Padding="56,12,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ShowLineTitle" />
                            <TextBlock x:Name="ShowLineDesc" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ShowLineSwitch" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnAdvancedToggled" />
                    </Grid>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
