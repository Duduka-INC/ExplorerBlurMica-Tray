<UserControl x:Class="ExplorerBlurMicaTray.App.PresetsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1000" Padding="40,16,40,32" Spacing="16">
            <TextBlock x:Name="HeaderText" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,4" />

            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="True" />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="IntroText" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="OnSaveCurrent">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock x:Name="SaveButtonText" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Preset tiles, three or fewer per row depending on the width; built in code. -->
            <Grid x:Name="Tiles" ColumnSpacing="16" RowSpacing="16" />

            <TextBlock x:Name="EmptyHint" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
