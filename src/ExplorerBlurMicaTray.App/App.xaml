<Application x:Class="ExplorerBlurMicaTray.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A settings card like the ones in Windows Settings. -->
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
            <Style x:Key="SettingsCardRow" TargetType="Grid">
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="MinHeight" Value="66" />
            </Style>
            <Style x:Key="SettingsSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
